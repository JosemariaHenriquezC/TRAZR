# ===================================================================
# Copiá este archivo como ".env" y completá los valores.
# NUNCA subas el .env a GitHub (ya está en .gitignore).
# ===================================================================

# --- Telegram -------------------------------------------------------
# Token que te da @BotFather al crear el bot (paso 1 del README).
TELEGRAM_BOT_TOKEN=

# --- WhatsApp (Cloud API de Meta) ------------------------------------
# Se activa cuando están los cuatro. Están en developers.facebook.com → tu app:
#   WHATSAPP_TOKEN            «Paso 1. Pruébalo» → Generar token (el de prueba vence a las 24 h)
#   WHATSAPP_PHONE_NUMBER_ID  «Phone Number ID» en esa misma pantalla
#   WHATSAPP_APP_SECRET       Configuración de la app → Básica → Clave secreta de la app
#   WHATSAPP_VERIFY_TOKEN     una palabra que inventás vos; la misma va en Meta al configurar el webhook
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v25.0
# Plantillas para avisar pasadas las 24 h (pedido aprobado, pago recibido...). Se crean con
#   python -m scripts.plantillas_whatsapp --crear
# WHATSAPP_WABA_ID: «Identificador de la cuenta de mensajes» (pantalla «Paso 1. Pruébalo»).
WHATSAPP_WABA_ID=
WHATSAPP_PLANTILLAS_IDIOMA=es_AR

# --- Túnel para WhatsApp (ngrok) ------------------------------------
# Tu dominio fijo de ngrok (panel de ngrok → Domains). Si está, «python -m app.server» abre
# el túnel solo (y Ctrl+C lo cierra). En Meta el webhook es https://<este dominio>/whatsapp/webhook
NGROK_DOMAIN=

# --- Web de administración ------------------------------------------
# Clave para firmar la sesión de los admins. Generá una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Si la dejás vacía se genera una al arrancar (y hay que volver a ingresar cada vez).
SECRET_KEY=
WEB_HOST=127.0.0.1
WEB_PORT=8000

# --- Base de datos ---------------------------------------------------
# Archivo SQLite con catálogo de bebidas, clientes y pedidos. Se crea solo.
# Cargá el catálogo con: python -m scripts.init_db --ejemplo  (o --csv archivo.csv)
DATABASE_PATH=data/trazr.db

# --- Presentación ---------------------------------------------------
CURRENCY_SYMBOL=$
# Zona horaria para fechas de pedidos y vigencia de precios (formato IANA).
# Ej.: America/Argentina/Buenos_Aires, America/Mexico_City, Europe/Madrid
TIMEZONE=America/Argentina/Buenos_Aires

# --- Regla "dentro de los parámetros" ----------------------------------
# Confirmación automática si: producto existe y activo + stock suficiente + cliente verificado.
# Los precios no vencen. El PRIMER pedido de cada empresa va a revisión (web); desde que
# tiene un pedido pagado, sus pedidos se confirman solos.
REVISAR_CLIENTES_NUEVOS=true
RULE_REQUIRE_STOCK=true            # no dejar pedir más de lo que hay (el bot ofrece ajustar)
MAX_ORDER_TOTAL=0                  # opcional: total máximo para confirmar solo (0 = sin límite)
MAX_QTY_PER_ITEM=1000              # cantidades mayores se rechazan como inválidas
ON_UNKNOWN_PRODUCT=ask             # ask = pedir corrección al cliente | review = derivar a revisión
MATCH_THRESHOLD=0.72               # 0..1, similitud mínima para reconocer un producto escrito
MODIFICACION_MINUTOS=60            # minutos que tiene el cliente para modificar un pedido hecho
PAGO_HORAS=24                      # una transferencia sin pagar se cancela sola pasadas estas horas

# --- Gemini (intérprete y redacción de respuestas) ----------------------
# Gemini entiende los mensajes y redacta las respuestas; precios, stock,
# totales y estados los pone siempre el bot desde la base de datos.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
AI_PARSER_ENABLED=true
AI_TIMEOUT_SECONDS=8
# Si Gemini no contesta, el bot le dice al cliente que espere y reintenta tras estas pausas (segundos).
# Si sigue sin contestar, le pide que escriba de nuevo en unos minutos.
AI_RETRY_DELAYS=3

# --- Datos del negocio (Gemini los usa para responder consultas) --------
# Tienda ficticia de ejemplo «Trazr». Si borrás estas líneas del .env se usan
# estos mismos valores; si dejás una vacía, Gemini dice que lo consulta con el equipo.
NEGOCIO_NOMBRE=Trazr
NEGOCIO_HORARIOS=lunes a sábado de 9 a 13 y de 17 a 21; domingos y feriados cerrado. Los pedidos confirmados antes de las 13 se entregan en el día; después de las 13, el siguiente día hábil.
NEGOCIO_ZONA=San Miguel de Tucumán, Yerba Buena, Tafí Viejo y Banda del Río Salí
NEGOCIO_PEDIDO_MINIMO=no hay pedido mínimo
NEGOCIO_PAGOS=efectivo o transferencia bancaria al recibir el pedido
NEGOCIO_ALIAS=TRAZR.BEBIDAS.TUC     # alias para transferencias (de ejemplo: poné el tuyo)
NEGOCIO_TITULAR=Trazr Distribuidora (cuenta de ejemplo)
NEGOCIO_HORA_APERTURA=9            # para el tablero de la web: horario y corte de entrega
NEGOCIO_HORA_CIERRE=21
NEGOCIO_DIAS_REPARTO=lun-sab        # días que se reparte (para «sale hoy / sale el lunes»)
NEGOCIO_HORA_CORTE=13              # lo confirmado antes de esta hora sale en el día
NEGOCIO_CONTACTO=                  # mail o teléfono para la página /privacidad (vacío = «por el chat»)
NEGOCIO_INFO=Trazr es una distribuidora de bebidas de Tucumán: gaseosas, aguas, cervezas, vinos, aperitivos, jugos y energizantes. Venta a mayoristas, almacenes y particulares. Las bebidas alcohólicas solo se venden a mayores de 18 años.
