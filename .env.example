# ===================================================================
# Copiá este archivo como ".env" y completá los valores.
# NUNCA subas el .env ni credentials.json a GitHub (ya están en .gitignore).
# ===================================================================

# --- Telegram -------------------------------------------------------
# Token que te da @BotFather al crear el bot (paso 1 del README).
TELEGRAM_BOT_TOKEN=9098652815:AAGpCrtXRHld4D9sUfOYv2W8Kt5Mox3DHUg
# Tu ID de Telegram (y el de otros admins), separados por coma.
# Lo obtenés escribiéndole /miid a tu bot.
ADMIN_CHAT_IDS=1148359245

# --- Almacenamiento ------------------------------------------------
# gsheets = Google Sheets (producción) | excel = archivos locales (pruebas)
STORAGE_BACKEND=gsheets

# Google Sheets: archivo JSON de la cuenta de servicio (paso 3 del README)
GOOGLE_CREDENTIALS_FILE=credentials.json
# ID de cada hoja: es la parte de la URL entre /d/ y /edit
# https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit
STOCK_SPREADSHEET_ID=1SaQKlTKk2rNHiizNyyaEQpJIzUVjDQKQD6aGhS0VcRA
ORDERS_SPREADSHEET_ID=1GTs2e3t0PRppS6CyLK8sfwJV2HhgypzVnehObq4qqxM
# Nombre de la pestaña dentro de cada hoja
STOCK_WORKSHEET=Stock
ORDERS_WORKSHEET=Pedidos

# Excel local (solo si STORAGE_BACKEND=excel)
EXCEL_STOCK_PATH=data/stock.xlsx
EXCEL_ORDERS_PATH=data/pedidos.xlsx

# --- Presentación ---------------------------------------------------
CURRENCY_SYMBOL=$
# Zona horaria para fechas de pedidos y vigencia de precios (formato IANA).
# Ej.: America/Argentina/Buenos_Aires, America/Mexico_City, Europe/Madrid
TIMEZONE=America/Argentina/Buenos_Aires

# --- Regla "dentro de los parámetros" ----------------------------------
# Confirmación automática solo si: producto existe y activo + precio vigente + stock suficiente.
RULE_REQUIRE_PRICE_VALID=true      # exigir Precio>0 y Vigente_hasta vacío o >= hoy
RULE_REQUIRE_STOCK=true            # exigir Stock >= cantidad pedida
MAX_ORDER_TOTAL=0                  # total máximo para confirmar solo (0 = sin límite)
MAX_QTY_PER_ITEM=1000              # cantidades mayores se rechazan como inválidas
ON_UNKNOWN_PRODUCT=ask             # ask = pedir corrección al cliente | review = derivar a revisión
MATCH_THRESHOLD=0.72               # 0..1, similitud mínima para reconocer un producto escrito

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
AI_PARSER_ENABLED=true
AI_TIMEOUT_SECONDS=15